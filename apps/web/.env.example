# Convex — both URLs are on the Convex dashboard under Settings
NEXT_PUBLIC_CONVEX_URL=https://expert-crocodile-824.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://expert-crocodile-824.convex.site

# Auth.js — NEXTAUTH_URL must match the deployed origin exactly in production,
# and that origin must be an authorised redirect URI in the Google console.
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (cloudinary.com) — scan images and doctor licence documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RS256 private key this app signs Convex tokens with. Full PKCS#8 PEM,
# BEGIN/END lines included, real newlines — importPKCS8 rejects a bare
# base64 body and rejects PKCS#1 ("BEGIN RSA PRIVATE KEY"). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# The matching public key is the JWKS committed in convex/auth.config.ts.
CONVEX_JWT_PRIVATE_KEY=

# Comma-separated emails granted the admin role
NEXT_PUBLIC_ADMIN_EMAILS=

# Diagnostic engine — separate repo, separate host (HF Space or Render).
# AI_SERVICE_API_KEY must equal the engine's own API_KEY. Leave both unset
# locally: the engine runs open when its API_KEY is unset.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
