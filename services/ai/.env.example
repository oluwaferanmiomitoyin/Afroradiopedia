GEMINI_API_KEY=
NEXTJS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face access token with the MedGemma (Health AI Developer Foundations)
# terms accepted on https://huggingface.co/google/medgemma-1.5-4b-it — without
# this, the "Deep scan" engine stays unavailable and every request falls back
# to Gemini automatically.
HF_TOKEN=

# Optional: require this in an X-API-Key header on /analyze. Leave unset for
# local dev (open) — set it once this service is deployed publicly.
API_KEY=

# Optional: comma-separated hostname allowlist for image URLs (e.g. your
# Cloudinary host). Leave unset to allow any HTTPS host (still blocks
# private/loopback IPs).
ALLOWED_IMAGE_HOSTS=